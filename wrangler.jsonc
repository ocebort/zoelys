{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoelys",
  "compatibility_date": "2026-03-01",
  "pages_build_output_dir": "./public",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "zoelys_db",
      "database_name": "zoelys-db",
      "database_id": "zoelys-db"
    }
  ]
}
