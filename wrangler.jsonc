{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zoelys",
	"compatibility_date": "2026-03-01",
	"main": "index.js",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "zoelys_db",
