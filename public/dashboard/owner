<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zoélys - Tableau de bord Propriétaire</title>
    <!-- Tailwind CSS pour un design pro -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Top Navbar -->
    <header class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center shadow-sm">
        <div class="flex items-center space-x-3">
            <span class="text-2xl font-bold text-indigo-600">🐾 Zoélys</span>
            <span class="text-xs bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full font-medium">Espace Propriétaire</span>
        </div>
        <div class="flex items-center space-x-4">
            <span id="user-email" class="text-sm text-slate-600">Chargement...</span>
            <button onclick="logout()" class="text-sm text-red-600 hover:text-red-800 font-medium">Déconnexion</button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-6 grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Sidebar / Quick Info -->
        <div class="space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-lg font-bold text-slate-900 mb-2">Actions Rapides</h2>
                <div class="space-y-3">
                    <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-xl transition duration-200 shadow-sm">
                        + Ajouter un animal
                    </button>
                    <button class="w-full bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium py-2.5 px-4 rounded-xl transition duration-200">
                        Réserver un Pet-Sitter
                    </button>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <h2 class="text-lg font-bold text-slate-900 mb-2">Sécurité & Urgence</h2>
                <p class="text-sm text-slate-500 mb-4">Gérez vos contacts d'urgence et la limite de prise en charge vétérinaire.</p>
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-800">
                    ⚠️ En cas d'urgence, les sitters ont l'autorisation de contacter votre clinique vétérinaire référente.
                </div>
            </div>
        </div>

        <!-- Main Content Area: Pets List & Details -->
        <div class="md:col-span-2 space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-xl font-bold text-slate-900">Mes Animaux</h2>
                    <span id="pet-count" class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-medium">0 animal</span>
                </div>

                <!-- Liste des animaux (injectée dynamiquement) -->
                <div id="pets-container" class="space-y-6">
                    <div class="text-center py-8 text-slate-400">Chargement de vos compagnons...</div>
                </div>
            </div>
        </div>

    </main>

    <!-- JavaScript pour charger les données -->
    <script>
        async function loadOwnerDashboard() {
            try {
                // Remplace par ton endpoint API réel qui récupère les animaux connectés
                const response = await fetch('/api/owner/pets');
                const data = await response.json();

                const container = document.getElementById('pets-container');
                const countBadge = document.getElementById('pet-count');

                if (!data.pets || data.pets.length === 0) {
                    container.innerHTML = `<p class="text-slate-500 text-center py-6">Aucun animal enregistré pour le moment.</p>`;
                    return;
                }

                countBadge.innerText = `${data.pets.length} animal${data.pets.length > 1 ? 's' : ''}`;
                container.innerHTML = '';

                data.pets.forEach(pet => {
                    container.innerHTML += `
                        <div class="border border-slate-200 rounded-2xl p-5 hover:border-indigo-200 transition duration-200 bg-slate-50/50">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-lg font-bold text-slate-900">${pet.name}</h3>
                                    <p class="text-sm text-indigo-600 font-medium">${pet.breed} • ${pet.weight_kg} kg • ${pet.gender}</p>
                                </div>
                                <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-medium">Profil Actif</span>
                            </div>

                            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-600 bg-white p-4 rounded-xl border border-slate-100">
                                <div>
                                    <span class="font-semibold text-slate-700 block mb-1">🕒 Routine quotidienne :</span>
                                    <p class="text-xs text-slate-500">${pet.daily_schedule || 'Non renseignée'}</p>
                                </div>
                                <div>
                                    <span class="font-semibold text-slate-700 block mb-1">🚨 Vétérinaire & Urgence :</span>
                                    <p class="text-xs text-slate-500">${pet.vet_name || 'Non renseigné'} (${pet.vet_phone || 'N/A'})</p>
                                    <p class="text-xs font-medium text-indigo-600 mt-1">Limite vet : €${pet.emergency_vet_limit || 0}</p>
                                </div>
                            </div>

                            <div class="mt-4 flex space-x-3">
                                <button class="text-xs bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium py-2 px-3 rounded-lg transition">Modifier le profil</button>
                                <button class="text-xs bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium py-2 px-3 rounded-lg transition">Carnet de santé</button>
                            </div>
                        </div>
                    `;
                });

            } catch (err) {
                console.error("Erreur de chargement", err);
                document.getElementById('pets-container').innerHTML = `<p class="text-red-500 text-center py-6">Impossible de charger les profils d'animaux.</p>`;
            }
        }

        function logout() {
            // Logique de déconnexion à adapter selon ton système de session
            window.location.href = '/login/';
        }

        // Charger au démarrage
        loadOwnerDashboard();
    </script>
</body>
</html>
